{
  "enabled": true,
  "name": "Keep secrets out of source",
  "description": "When API or client code is saved, checks that no token, passcode or key is hard-coded.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["api/**/*.ts", "src/**/*.ts", "src/**/*.tsx"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Check the edited file for hard-coded secrets (bot tokens, passcodes, API keys). Secrets must come from process.env. Report and fix any you find."
  }
}

# Passcode a caregiver types into Settings. Required for alerts and the caregiver question flow.
ALERT_PASSCODE=

# Telegram alerts. TELEGRAM_CHAT_ID is optional: if it is empty, the server uses
# the chat of the most recent /start message sent to the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Shared store for the caregiver question flow across two devices (optional).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentence suggestions from any OpenAI-compatible chat endpoint (optional).
# Without these, suggestions come from the built-in phrase list.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Copy to .env and fill in. .env is git-ignored. On Vercel, add the same names under Project Settings > Environment Variables.

# Sentence suggestions. Groq is tried first, then Gemini. With neither, a built-in phrase bank is used.
GROQ_API_KEY=
GEMINI_API_KEY=

# Telegram alerts. If TELEGRAM_CHAT_ID is empty, the chat that last sent /start to the bot is used.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Passcode the caregiver types into Settings. Required for alerts and caregiver questions.
ALERT_PASSCODE=

# Optional: share caregiver questions between two devices.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
